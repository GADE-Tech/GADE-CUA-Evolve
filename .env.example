# LLM credentials
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_AK=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OSWorld cloud provider credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Volcengine ECS (required when env.provider_name=volcengine)
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
# The local OSWorld checkout also accepts these legacy names:
VOLCANO_ENGINE_ACCESS_KEY=
VOLCANO_ENGINE_SECRET_KEY=
VOLCENGINE_REGION=<region>
VOLCENGINE_ZONE_ID=<zone-id>
VOLCENGINE_IMAGE_ID=<image-id>
VOLCENGINE_INSTANCE_TYPE=<instance-type>
VOLCENGINE_SUBNET_ID=<subnet-id>
VOLCENGINE_SECURITY_GROUP_ID=<security-group-id>
# Required by the pinned GADE-Tech/OSWorld Volcengine provider. Never commit the value.
VOLCENGINE_DEFAULT_PASSWORD=<vm-password>
